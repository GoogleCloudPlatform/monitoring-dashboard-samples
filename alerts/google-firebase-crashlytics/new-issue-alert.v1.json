{
  "displayName": "Crashlytics New Issue",
  "combiner": "OR",
  "enabled": true,
  "severity": "WARNING",
  "conditions": [
    {
      "displayName": "New issue detected",
      "conditionMatchedLog": {
        "filter": "logName=\"projects/${PROJECT_ID}/logs/clouderrorreporting.googleapis.com%2Finsights\" AND labels.activity_type_name=\"CrashReportingErrorGroupNew\" AND labels.notificationType=\"New\" AND labels.deploymentAppId=\"${GMP_APP_ID}\"",
        "labelExtractors": {
          "issue_id": "EXTRACT(labels.errorGroupId)",
          "error": "EXTRACT(jsonPayload.exceptionInfo.type)",
          "message": "EXTRACT(jsonPayload.exceptionInfo.message)",
          "app_id": "EXTRACT(labels.deploymentAppId)",
          "version": "EXTRACT(labels.deploymentVersion)",
          "path": "EXTRACT(labels.causeFullFilePath)"
        }
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "300s"
    },
    "autoClose": "1800s",
    "notificationPrompts": [
      "OPENED"
    ]
  },
  "documentation": {
    "mimeType": "text/markdown",
    "subject": "Crashlytics Web New Issue",
    "content": "<div style=\"border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; max-width: 600px; margin: 0 auto; background-color: #fff; font-family: Roboto, Helvetica, Arial, sans-serif;\">\n  <div style=\"padding: 24px 24px 0 24px;\">\n    <img src=\"https://www.gstatic.com/mobilesdk/240501_mobilesdk/firebase_128dp.png\" height=\"40\" alt=\"Firebase\" style=\"height: 40px; vertical-align: middle; margin-right: 5px;\" />\n    <span style=\"font-family: Google Sans, Roboto, sans-serif; font-size: 30px; font-weight: 400; line-height: 30px; color: #666; vertical-align: middle;\">Firebase</span>\n  </div>\n  <table style=\"width: 100%; border-spacing: 0;\">\n    <tr>\n      <td style=\"padding: 24px 24px 12px 24px;\">\n        <p style=\"color: #666; font-size: 14px; line-height: 24px; margin: 0 0 4px 0;\">${project} &bull; <img src=\"https://www.gstatic.com/mobilesdk/240222_mobilesdk/platform_web_grey@2x.png\" width=\"16\" height=\"16\" style=\"vertical-align: -3px; margin: 0 4px 0 2px;\" alt=\"Web\" />${log.extracted_label.app_id}</p>\n        <h1 style=\"font-size: 20px; line-height: 24px; font-weight: 400; color: #202124; margin: 0;\">New Issue</h1>\n      </td>\n      <td style=\"padding: 24px; text-align: right; vertical-align: middle;\"><img src=\"https://www.gstatic.com/mobilesdk/240221_mobilesdk/crashlytics_icon_grey@2x.png\" width=\"24\" height=\"24\" alt=\"Crashlytics\" /></td>\n    </tr>\n  </table>\n  <div style=\"height: 1px; background-color: #e0e0e0; width: 92%; margin: 0 auto;\"></div>\n  <div style=\"border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; width: 85%; max-width: 430px; margin: 40px auto 0 auto;\">\n    <div style=\"background-color: #fff3e0; color: #c53929; padding: 24px 12px; text-align: center; font-family: Helvetica Neue, Helvetica, Arial, sans-serif;\">\n      <img src=\"https://www.gstatic.com/mobilesdk/260827_mobilesdk/crashlytics_issue_alert@2x.png\" width=\"60\" height=\"60\" alt=\"\" style=\"display: block; margin: 0 auto 12px auto;\" />\n      <h2 style=\"font-size: 22px; font-weight: 400; line-height: 28px; color: #c53929; margin: 0;\">Heads up! We detected a new issue in ${log.extracted_label.app_id} ${log.extracted_label.version}</h2>\n      <a href=\"https://console.firebase.google.com/v1/appid/project/${project}/crashlytics/app/${log.extracted_label.app_id}/issues/${log.extracted_label.issue_id}\" style=\"display: inline-block; background-color: #c53929; color: #fff; text-decoration: none; font-family: Roboto, sans-serif; font-size: 16px; line-height: 24px; font-weight: 500; letter-spacing: 0.25px; padding: 12px 20px; border-radius: 100px; margin-top: 24px;\">View issue details</a>\n    </div>\n    <div style=\"background-color: #fff; border-top: 1px solid #e0e0e0; padding: 20px 15px; text-align: left;\">\n      <div style=\"font-weight: 500; letter-spacing: 0.5px; font-size: 14px; color: #202124; padding: 8px 0; word-break: break-word;\">${log.extracted_label.path}</div>\n      <div style=\"font-family: Courier, monospace; font-size: 14px; letter-spacing: 0.3px; line-height: 140%; color: #202124; word-break: break-word;\">[${log.extracted_label.error}: ${log.extracted_label.message}]</div>\n    </div>\n  </div>\n  <div style=\"background-color: #fafafa; padding: 24px; margin-top: 48px; text-align: center; color: #4e5f7e; font-size: 12px; line-height: 16px;\">\n    <p style=\"margin: 0;\">This email is notifying you about important service information regarding your Firebase project</p>\n    <p style=\"margin: 20px 0 0 0;\">Manage your <a href=\"https://console.firebase.google.com/project/${project}/settings/alerts\" style=\"color: #0957d0; text-decoration: underline;\">Alert settings</a></p>\n  </div>\n</div>\n"
  },
  "notificationChannels": []
}
