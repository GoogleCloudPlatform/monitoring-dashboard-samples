            "thresholds": [
              {
                "value": 15000,
                "color": "YELLOW",
                "direction": "ABOVE",
                "label": "slow"
              },
              {
                "value": 30000,
                "color": "RED",
                "direction": "ABOVE",
                "label": "very slow"
              }
